# Copy this file to `.env.local`, then edit the copy.
# Restart `npm run dev` after every change. A production build has to be rebuilt.
#
# Everything starting with NEXT_PUBLIC_ is visible to every visitor. Never put a
# secret here. If a map provider gives you a token, use a public one and restrict
# it to your own domain in the provider's dashboard.

# local  = campus shapes on a plain background. Nothing is loaded from other sites.
# online = visitors are asked first, then a street map loads from NEXT_PUBLIC_TILE_URL.
NEXT_PUBLIC_BASEMAP_MODE=local

# Only used when the mode is online. Two formats work:
#   1. a MapLibre style:   https://tiles.openfreemap.org/styles/liberty  (default)
#   2. a raster tile URL:  https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Check the provider's terms first. OpenStreetMap's own tile server (format 2) is
# fine for a quick local test, not for a public site:
# https://operations.osmfoundation.org/policies/tiles/
NEXT_PUBLIC_TILE_URL=

# The credit line for a raster tile URL (format 2). Styles bring their own.
NEXT_PUBLIC_TILE_ATTRIBUTION=

# 1 = allow the fake GPS (the ?mock=1 address) and the demo tools in this build.
# Keep it 0 for the real site: then ?mock=1 does nothing.
NEXT_PUBLIC_ENABLE_DEMO=0

# 1 = start with the fake GPS without needing ?mock=1. Needs ENABLE_DEMO=1.
NEXT_PUBLIC_MOCK_LOCATION=0
